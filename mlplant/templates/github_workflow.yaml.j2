# .github/workflows/mlplant-ci.yaml — generated by mlplant
name: {{ project }} CI/CD

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install -r requirements.txt pytest httpx

      - name: Run unit tests
        run: pytest tests/ -v --tb=short
{% if docker %}

  build-and-smoke:
    runs-on: ubuntu-latest
    needs: test
    steps:
      - uses: actions/checkout@v4

      - name: Build Docker image
        run: docker build -t {{ project | lower | replace(' ', '-') }}:$GITHUB_SHA .

      - name: Smoke-test /health
        run: |
          docker run -d -p {{ port }}:{{ port }} --name api-smoke \
            {{ project | lower | replace(' ', '-') }}:$GITHUB_SHA
          sleep 5
          curl -sf http://localhost:{{ port }}/health
          docker stop api-smoke
{% endif %}
{% if mlflow %}

  mlflow-check:
    runs-on: ubuntu-latest
    needs: test
    env:
      MLFLOW_TRACKING_URI: {{ mlflow_tracking_uri }}
    steps:
      - uses: actions/checkout@v4
      - name: Verify MLflow connectivity
        run: |
          pip install mlflow
          python -c "import mlflow; mlflow.set_tracking_uri('$MLFLOW_TRACKING_URI'); print('MLflow OK')"
{% endif %}
