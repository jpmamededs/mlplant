def _is_estimator(obj: Any) -> bool:
    return hasattr(obj, "fit") and hasattr(obj, "predict")


def _extract_models(local_vars: dict) -> Dict[str, Any]:
    models: Dict[str, Any] = {}
    for name, obj in local_vars.items():
        if name.startswith("_"):
            continue
        if _is_estimator(obj):
            models[name] = obj
    return models


def _extract_metrics(local_vars: dict) -> Dict[str, Any]:
    metrics: Dict[str, Any] = {}
    for name, value in local_vars.items():
        lname = name.lower()
        if "metric" in lname or "score" in lname or lname.startswith("f1"):
            if isinstance(value, (int, float)):
                metrics[name] = float(value)
            elif hasattr(value, "item"):
                try:
                    metrics[name] = float(value.item())
                except Exception:
                    continue
    return metrics


def _mlflow_safe_params(local_vars: dict) -> Dict[str, Any]:
    serializable: Dict[str, Any] = {}
    for key, value in local_vars.items():
        if key.startswith("_"):
            continue
        if isinstance(value, (str, int, float, bool)):
            serializable[key] = value
    return serializable


def _to_list(values: Any) -> list:
    if hasattr(values, "tolist"):
        return values.tolist()
    return list(values)


def _auto_select_model(models: Dict[str, Any], X_val: Any, y_val: Any) -> tuple[str | None, Dict[str, float]]:
    """Choose the best model on validation data and return per-model scores."""
    if X_val is None or y_val is None:
        return None, {}

    try:
        from sklearn.metrics import balanced_accuracy_score, r2_score
    except Exception:
        return None, {}

    y_list = _to_list(y_val)
    unique_targets = set(y_list)
    if len(unique_targets) <= 1:
        return None, {}

    is_classification = all(isinstance(v, (str, bool, Integral)) for v in unique_targets)

    best_name = None
    best_score = float("-inf")
    score_name = "balanced_accuracy" if is_classification else "r2"
    model_scores: Dict[str, float] = {}

    for name, model in models.items():
        try:
            y_pred = model.predict(X_val)
            if is_classification:
                score = float(balanced_accuracy_score(y_val, y_pred))
            else:
                score = float(r2_score(y_val, y_pred))
        except Exception:
            continue

        model_scores[f"val_{score_name}_{name}"] = score
        if score > best_score:
            best_score = score
            best_name = name

    return best_name, model_scores


