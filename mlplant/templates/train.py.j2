def _local_mlflow_tracking_uri() -> str:
    custom_local_uri = os.getenv("MLFLOW_LOCAL_TRACKING_URI", "").strip()
    if custom_local_uri:
        return custom_local_uri

    artifacts_dir = os.getenv("MLPLANT_ARTIFACTS_DIR", "artifacts")
    artifacts_path = Path(artifacts_dir).resolve()
    artifacts_path.mkdir(parents=True, exist_ok=True)
    db_path = artifacts_path / "mlflow.db"
    db_uri = db_path.as_posix()
    return f"sqlite:///{db_uri}"


def _start_mlflow_run() -> tuple[bool, Any]:
    """Start MLflow run with local fallback when remote tracking is unavailable."""
    preferred_uri = os.getenv("MLFLOW_TRACKING_URI", "{{ mlflow_tracking_uri }}").strip()

    if preferred_uri:
        try:
            mlflow.set_tracking_uri(preferred_uri)
            mlflow.set_experiment("{{ title }}")
            run = mlflow.start_run()
            run.__enter__()
            return True, run
        except Exception as exc:
            print(
                f"[mlplant] MLflow remote tracking unavailable at {preferred_uri}: {exc}. "
                "Falling back to local file tracking."
            )

    local_uri = _local_mlflow_tracking_uri()
    mlflow.set_tracking_uri(local_uri)
    mlflow.set_experiment("{{ title }}")
    run = mlflow.start_run()
    run.__enter__()
    print(f"[mlplant] MLflow local tracking active at {local_uri}")
    return True, run
