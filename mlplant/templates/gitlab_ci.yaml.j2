# .gitlab-ci.yml — generated by mlplant
image: python:3.11

stages:
  - test
{% if docker %}
  - build
{% endif %}

test:
  stage: test
  script:
    - pip install -r requirements.txt pytest httpx
    - pytest tests/ -v --tb=short
{% if docker %}

build:
  stage: build
  image: docker:24
  services:
    - docker:24-dind
  variables:
    IMAGE_NAME: {{ project | lower | replace(' ', '-') }}
  script:
    - docker build -t $IMAGE_NAME:$CI_COMMIT_SHA .
    - docker run -d -p {{ port }}:{{ port }} --name smoke $IMAGE_NAME:$CI_COMMIT_SHA
    - sleep 5
    - curl -sf http://localhost:{{ port }}/health
    - docker stop smoke
{% endif %}
