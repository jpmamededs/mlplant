_runtime: Dict[str, Any] = {
    "models": {},
    "label_encoder": None,
    "selected_model": None,
    "metadata": {},
}


def _load_legacy_runtime() -> Dict[str, Any]:
    models = {}
    label_encoder = None

    legacy_models_dir = "models"
    if not os.path.isdir(legacy_models_dir):
        raise RuntimeError(
            "No artifacts were found. Run training before starting the API."
        )

    for filename in os.listdir(legacy_models_dir):
        file_path = os.path.join(legacy_models_dir, filename)
        if filename == "label_encoder.joblib":
            label_encoder = joblib.load(file_path)
        elif filename.endswith(".joblib"):
            models[filename[:-7]] = joblib.load(file_path)

    if not models:
        raise RuntimeError("No trained models found in legacy 'models/' directory.")

    selected_model = next(iter(models.keys()))
    return {
        "models": models,
        "label_encoder": label_encoder,
        "selected_model": selected_model,
        "metadata": {"source": "legacy_models_dir"},
    }


def _ensure_runtime_loaded() -> None:
    if _runtime["models"]:
        return

    if callable(load_runtime_bundle):
        bundle = load_runtime_bundle()
    else:
        bundle = _load_legacy_runtime()

    _runtime.update(bundle)


def preload_runtime() -> None:
    """Preload runtime artifacts during API startup."""
    _ensure_runtime_loaded()


def _expected_feature_names(model: Any) -> list[str]:
    """Extract expected feature order from sklearn/xgboost/catboost-like models."""
    if hasattr(model, "feature_names_in_"):
        try:
            names = [str(c) for c in model.feature_names_in_.tolist()]
            if names:
                return names
        except Exception:
            pass

    if hasattr(model, "get_booster"):
        try:
            booster = model.get_booster()
            names = [str(c) for c in (booster.feature_names or [])]
            if names:
                return names
        except Exception:
            pass

    meta = _runtime.get("metadata") or {}
    extra = meta.get("extra") if isinstance(meta, dict) else None
    if isinstance(extra, dict):
        names = extra.get("feature_columns")
        if isinstance(names, list) and names:
            return [str(c) for c in names]

    return []


def _align_features_for_model(df: pd.DataFrame, model: Any) -> pd.DataFrame:
    """Align incoming dataframe to training-time feature columns."""
    expected = _expected_feature_names(model)
    if not expected:
        return df

    aligned = df.copy()

    # Replace bool dtypes by ints for stable model ingestion.
    for col in aligned.columns:
        if aligned[col].dtype == bool:
            aligned[col] = aligned[col].astype(int)

    for col in expected:
        if col not in aligned.columns:
            aligned[col] = 0.0

    aligned = aligned[expected]
    return aligned


def _predict_from_models(df: pd.DataFrame) -> tuple[Any, str | None]:
    models = _runtime["models"]
    if not models:
        raise RuntimeError("No trained model loaded in runtime cache.")

    selected_name = _runtime.get("selected_model")
    selected_model = models.get(selected_name) if selected_name else None

    if selected_model is not None:
        if hasattr(selected_model, "predict"):
            aligned_df = _align_features_for_model(df, selected_model)
            raw = selected_model.predict(aligned_df)[0]
        else:
            raise RuntimeError(f"Model '{selected_name}' does not implement predict().")
        return raw, selected_name

    all_models = list(models.items())
    probas = []
    numeric_preds = []
    raw_preds = []

    for _, model in all_models:
        aligned_df = _align_features_for_model(df, model)
        if hasattr(model, "predict_proba"):
            probas.append(model.predict_proba(aligned_df))
            continue

        pred_value = model.predict(aligned_df)[0]
        raw_preds.append(pred_value)
        if isinstance(pred_value, (int, float, np.number, np.integer, np.floating)):
            numeric_preds.append(float(pred_value))

    if probas:
        avg_proba = np.mean(np.stack(probas), axis=0)
        predicted = int(np.argmax(avg_proba, axis=1)[0])
        return predicted, None

    if numeric_preds:
        return float(np.mean(numeric_preds)), None

    return raw_preds[0], None


def predict(data: dict):
    """Run inference on a single input sample and return only the prediction."""
    result = predict_with_metadata(data)
    return result["prediction"]


def predict_with_metadata(data: dict) -> Dict[str, Any]:
    """Run inference and return prediction plus model metadata."""
    _ensure_runtime_loaded()

    df = pd.DataFrame([data])
    featured = build_features(df)
    if featured is not None:
        df = featured

    processed = preprocess(df)
    if processed is not None:
        df = processed

    raw_prediction, model_name = _predict_from_models(df)

    label_encoder = _runtime.get("label_encoder")
    if label_encoder is not None and isinstance(
        raw_prediction, (int, np.integer, np.int64)
    ):
        try:
            decoded = label_encoder.inverse_transform([int(raw_prediction)])[0]
            raw_prediction = decoded
        except Exception:
            pass

    return {
        "prediction": raw_prediction,
        "model": model_name or _runtime.get("selected_model"),
    }

