"""
main.py — FastAPI application generated by mlplant.
Title: {{ title }}
"""

import sys
import os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), "src"))

import time
from contextlib import asynccontextmanager

from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from src.predict import preload_runtime, predict_with_metadata
from src.schemas import InputData, PredictionResponse


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Load resources on startup; release on shutdown."""
    app.state.start_time = time.time()
    app.state.model_loaded = False
    app.state.model_error = None

    try:
        preload_runtime()
        app.state.model_loaded = True
    except Exception as exc:
        # API still boots to expose /health and /info for operations diagnosis.
        app.state.model_error = str(exc)

    yield


app = FastAPI(
    title="{{ title }}",
    description="ML inference API generated by mlplant.",
    version="1.0.0",
    lifespan=lifespan,
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)


# --- Endpoints ---

@app.get("/health", tags=["ops"])
def health():
    """Liveness check."""
    status = "ok" if app.state.model_loaded else "degraded"
    return {
        "status": status,
        "model_loaded": app.state.model_loaded,
        "model_error": app.state.model_error,
    }


@app.get("/info", tags=["ops"])
def info():
    """API metadata and uptime."""
    uptime = time.time() - app.state.start_time
    return {
        "title": "{{ title }}",
        "version": "1.0.0",
        "uptime_seconds": round(uptime, 2),
        "model_loaded": app.state.model_loaded,
        "model_error": app.state.model_error,
    }


@app.post("/predict", response_model=PredictionResponse, tags=["inference"])
def predict_endpoint(request: InputData):
    """Run model inference on the provided input data."""
    if not app.state.model_loaded:
        raise HTTPException(
            status_code=503,
            detail=app.state.model_error or "Model is not loaded yet.",
        )

    try:
        result = predict_with_metadata(request.model_dump())
        return PredictionResponse(**result)
    except ValueError as exc:
        raise HTTPException(status_code=400, detail=str(exc))
    except RuntimeError as exc:
        raise HTTPException(status_code=503, detail=str(exc))
    except Exception as exc:
        raise HTTPException(status_code=422, detail=str(exc))


if __name__ == "__main__":
    import uvicorn
    uvicorn.run("main:app", host="0.0.0.0", port={{ port }}, workers={{ workers }}, reload=False)

