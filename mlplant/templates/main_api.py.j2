from fastapi import FastAPI
from pydantic import BaseModel
from src.predict import predict as model_predict
{% if mlflow %}
import mlflow
{% endif %}

app = FastAPI(title="{{ title }}")


class PredictionInput(BaseModel):
    data: dict


@app.post("/predict")
def predict_endpoint(payload: PredictionInput):
    prediction = model_predict(payload.data)
    return {"prediction": prediction}


@app.get("/health")
def health():
    return {"status": "ok"}


if __name__ == "__main__":
    import uvicorn
    uvicorn.run("main:app", host="0.0.0.0", port={{ port }}, workers={{ workers }}, reload=False)
